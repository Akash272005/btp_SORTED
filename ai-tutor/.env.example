# Copy to .env and fill in secrets. Never commit .env.
#
# Choose ONE profile below:
#   • Local development — uncomment the LOCAL block (default for day-to-day dev)
#   • Production / Azure  — uncomment the PRODUCTION block; see docs/AZURE_POSTGRES_PRODUCTION.md

# ------------------------------------------------------------------------------
# App ports (scripts/start_web.py)
# ------------------------------------------------------------------------------
BACKEND_PORT=8001
# Use 3782 if localhost:4004 fails (Cursor IDE may bind 4004 on localhost)
FRONTEND_PORT=3782

# ------------------------------------------------------------------------------
# LLM — Azure OpenAI
# ------------------------------------------------------------------------------
LLM_BINDING=azure_openai
LLM_MODEL=gpt-5.2-chat
LLM_API_KEY=
LLM_HOST=https://YOUR_RESOURCE.openai.azure.com/openai/deployments/gpt-5.2-chat
LLM_API_VERSION=2024-08-01-preview

# ------------------------------------------------------------------------------
# Embeddings — Azure OpenAI
# ------------------------------------------------------------------------------
EMBEDDING_BINDING=azure_openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_HOST=https://YOUR_RESOURCE.openai.azure.com/openai/deployments/text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_API_VERSION=2024-08-01-preview

# ------------------------------------------------------------------------------
# TTS — Azure Cognitive Services
# ------------------------------------------------------------------------------
TTS_BINDING=azure_speech
SPEECH_KEY=
SPEECH_ENDPOINT=https://YOUR_RESOURCE.cognitiveservices.azure.com
TTS_VOICE=en-IN-NeerjaNeural
TTS_VOICE_HI=hi-IN-SwaraNeural
SPEECH_REGION=eastus2

# ------------------------------------------------------------------------------
# Web search
# ------------------------------------------------------------------------------
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# ------------------------------------------------------------------------------
# TLS (local only — never enable in production)
# ------------------------------------------------------------------------------
DISABLE_SSL_VERIFY=false
# SSL_CERT_FILE=/path/to/certifi/cacert.pem

# ------------------------------------------------------------------------------
# Azure AI Search (RAG)
# ------------------------------------------------------------------------------
AZURE_SEARCH_ENDPOINT=https://YOUR_SEARCH.search.windows.net
AZURE_SEARCH_KEY=

# ------------------------------------------------------------------------------
# NCERT PDFs (blob base URL, no trailing filename)
# ------------------------------------------------------------------------------
NCERT_STORAGE_BASE_URL=https://YOUR_STORAGE_ACCOUNT.blob.core.windows.net/pdfs/ncert/

# ------------------------------------------------------------------------------
# YouTube (Data API v3)
# ------------------------------------------------------------------------------
YOUTUBE_API_KEY=

# ------------------------------------------------------------------------------
# Related visuals — OCR / script gate
# ------------------------------------------------------------------------------
RELATED_VISUALS_STRICT_SCRIPT_VERIFY=true
GOOGLE_VISION_CREDENTIALS_PATH=keys/your-vision-service-account.json
GOOGLE_VISION_API_KEY=

# ------------------------------------------------------------------------------
# Smart Solver — photo/draw OCR (Azure-first)
# ------------------------------------------------------------------------------
SOLVER_OCR_PROVIDER=azure_vision
AZURE_VISION_ENDPOINT=https://YOUR_NAME.cognitiveservices.azure.com
AZURE_VISION_KEY=
# Set false to skip LLM math cleanup after OCR (not recommended for textbook photos)
SOLVER_OCR_LLM_CLEANUP=true
# Max OCR requests per client IP per minute (Smart Solver upload/draw)
SOLVER_OCR_RATE_LIMIT=20
# Optional: use Document Intelligence instead
# SOLVER_OCR_PROVIDER=azure_document_intelligence
# AZURE_DOC_INTELLIGENCE_ENDPOINT=https://YOUR_NAME.cognitiveservices.azure.com
# AZURE_DOC_INTELLIGENCE_KEY=

# ------------------------------------------------------------------------------
# Related visuals — Hindi AI image
# ------------------------------------------------------------------------------
RELATED_VISUALS_HINDI_AI_IMAGE_ENABLED=true
IMAGE_GEN_HOST=https://YOUR_RESOURCE.cognitiveservices.azure.com/openai/deployments/gpt-image-1.5
IMAGE_GEN_API_KEY=
IMAGE_GEN_API_VERSION=2025-04-01-preview
IMAGE_GEN_QUALITY=medium
IMAGE_GEN_OUTPUT_FORMAT=png
IMAGE_GEN_SIZE=1536x1024
IMAGE_GEN_LEGACY_RESPONSE_URL=false

# ------------------------------------------------------------------------------
# Video transcript cache (Azure Blob) — prefetch on Mac, serve from blob on Azure
# ------------------------------------------------------------------------------
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_BLOB_ACCOUNT_NAME=
# AZURE_BLOB_ACCOUNT_KEY=
TRANSCRIPT_CACHE_CONTAINER=video-transcripts
TRANSCRIPT_CACHE_DISABLED=false
# Prefetch: python scripts/publish_video_transcripts.py --video-id VIDEO_ID

# ==============================================================================
# LOCAL DEVELOPMENT (default — Homebrew PostgreSQL)
# ==============================================================================
DATABASE_URL=postgresql+psycopg2://AiTutor:local-dev-only-change-this@db:5432/AiTutor
POSTGRES_DB=AiTutor
POSTGRES_USER=AiTutor
POSTGRES_PASSWORD=local-dev-only-change-this
LMS_JWT_SECRET=dev-only-change-me
LMS_JWT_EXPIRE_HOURS=72
LMS_AT_RISK_THRESHOLD=50
PRODUCTION_MODE=false
TRANSCRIPT_LIVE_FETCH=true
NEXT_PUBLIC_API_BASE=http://localhost:8001

# ==============================================================================
# PRODUCTION (Azure PostgreSQL + Container Apps)
# Uncomment this block and comment out LOCAL block above.
# Deploy: docs/AZURE_POSTGRES_PRODUCTION.md
# ==============================================================================
# DATABASE_URL=postgresql+psycopg2://aitutoradmin:YOUR_PASSWORD@bixy-pg-prod.postgres.database.azure.com:5432/AiTutor?sslmode=require
# LMS_JWT_SECRET=
# LMS_JWT_EXPIRE_HOURS=72
# LMS_AT_RISK_THRESHOLD=50
# PRODUCTION_MODE=true
# TRANSCRIPT_LIVE_FETCH=false
# NEXT_PUBLIC_API_BASE=https://bixy-backend.jollybay-27d8f37d.centralindia.azurecontainerapps.io

# ------------------------------------------------------------------------------
# Optional
# ------------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=
# REDIS_URL=redis://localhost:6379/0
# NEXT_PUBLIC_API_BASE_EXTERNAL=
# GOOGLE_API_KEY=
# GOOGLE_CSE_ID=
# RELATED_VISUALS_MERMAID_ENABLED=true
# Residential/datacenter HTTPS proxy for YouTube captions (required on Azure/cloud IPs).
# Example: YOUTUBE_TRANSCRIPT_HTTPS_PROXY=http://user:pass@host:port
# YOUTUBE_TRANSCRIPT_HTTPS_PROXY=
